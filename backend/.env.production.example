# Backend Production Environment Variables
# COPY THIS FILE TO .env.production AND FILL WITH YOUR ACTUAL VALUES

# Server
NODE_ENV=production
PORT=5000

# Database MongoDB Atlas
# Get your connection string from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority

# JWT Secret (Generate a strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_64_characters

# Session Secret (Generate a strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_session_secret_here_minimum_64_characters

# Frontend URL
FRONTEND_URL=https://www.maguitaskin.com
